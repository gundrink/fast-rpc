# --- upstreams (free/public only; no paid provider needed) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# race reads across several RPCs (fastest healthy wins, hedged after RACE_HEDGE_MS)
# SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://your-other-free-rpc.example
RACE_HEDGE_MS=150
SOLANA_TIMEOUT_MS=10000
# extra sendTransaction fan-out targets
# SEND_RPC_URLS=
# Jito public block engine (no key required)
JITO_URL=https://mainnet.block-engine.jito.wtf
JITO_MIN_TIP_LAMPORTS=1000
SEND_JITO=0
TPU_FANOUT=4

# --- server ---
HOST=127.0.0.1
PORT=7070
# set TRUST_PROXY=1 behind Railway/Fly so per-IP limits see the client IP
TRUST_PROXY=0

# --- auth (OFF when both empty) ---
API_KEYS=
# API_KEYS_FILE=data/keys.json   # {"keys":[{"key":"...","project":"prolaunch","rps":50,"credits":1000000}]}
DEFAULT_RPS=
KEY_LIMITS=
# per-IP sliding window (0 = off); REDIS_URL makes it a shared fixed window
IP_LIMIT=0
IP_WINDOW_MS=1000
# REDIS_URL=redis://localhost:6379
# needed only to bind non-local with auth off
ALLOW_PUBLIC_NO_AUTH=0

# --- funded-by ---
LABELS_FILE=data/labels.json
FUNDED_BY_MAX_PAGES=3
FUNDED_BY_TIMEOUT_MS=30000
FUNDED_BY_CACHE_TTL_MS=3600000
# FUNDED_BY_CACHE_FILE=data/funded-by-cache.json
